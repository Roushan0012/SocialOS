# ==============================================================================
# SocialOS — Environment Variables Template
# ==============================================================================
# Copy this file to .env for local development:
#   cp .env.example .env
#
# IMPORTANT: Never commit actual secrets, API tokens, or private keys to Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Application & Security
# ------------------------------------------------------------------------------
ENVIRONMENT=development
DEBUG=true
APP_NAME=SocialOS
SECRET_KEY=change-this-in-production-use-a-strong-random-secret-key-32-chars
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ------------------------------------------------------------------------------
# 2. Database (PostgreSQL / Supabase)
# ------------------------------------------------------------------------------
# Local development default points to local PostgreSQL container or Supabase instance
# Note: SQLAlchemy 2.0 async uses postgresql+asyncpg://
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/socialos
# Production database target: Supabase Managed PostgreSQL
# DATABASE_URL=postgresql+asyncpg://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# ------------------------------------------------------------------------------
# 3. Cache & Queue (Redis 7.2+)
# ------------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ------------------------------------------------------------------------------
# 4. JWT & Authentication (Placeholders for future implementation)
# ------------------------------------------------------------------------------
# RS256 private and public key pairs (or base64 encoded strings)
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_ALGORITHM=RS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# OAuth Token Encryption at Rest (AES-256 Fernet key)
OAUTH_ENCRYPTION_KEY=

# ------------------------------------------------------------------------------
# 5. Production Media Storage: AWS S3 + Amazon CloudFront
# ------------------------------------------------------------------------------
# Note: AWS S3 + CloudFront is the singular production architecture standard.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=socialos-media-production
CLOUDFRONT_DOMAIN=

# ------------------------------------------------------------------------------
# 6. Local Development Media Storage: MinIO Only
# ------------------------------------------------------------------------------
# Used ONLY in local development (Docker Compose) for offline S3 API parity.
USE_LOCAL_STORAGE=true
MINIO_ENDPOINT=http://localhost:9000
MINIO_PUBLIC_ENDPOINT=http://localhost:9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET_NAME=socialos-media-local

# ------------------------------------------------------------------------------
# 7. Third-Party OAuth Integrations (Placeholders for future steps)
# ------------------------------------------------------------------------------
# Meta Graph API (Instagram & Facebook)
META_CLIENT_ID=
META_CLIENT_SECRET=
META_REDIRECT_URI=http://localhost:8000/api/v1/social-accounts/callback/meta

# LinkedIn Community API
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:8000/api/v1/social-accounts/callback/linkedin

# Google YouTube Data API v3
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/social-accounts/callback/google
