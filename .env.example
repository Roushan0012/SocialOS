# ==============================================================================
# SocialOS — Environment Variables Template
# ==============================================================================
# Copy this file to .env for local development:
#   cp .env.example .env
#
# IMPORTANT SECURITY RULES:
# 1. Never commit actual secrets, API tokens, database passwords, or private keys to Git.
# 2. .env is strictly gitignored.
# 3. SUPABASE_SECRET_KEY is backend-only; never expose it to client-side code.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Application & Security
# ------------------------------------------------------------------------------
ENVIRONMENT=development
DEBUG=true
APP_NAME=SocialOS
SECRET_KEY=change-this-in-production-use-a-strong-random-secret-key-32-chars
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ------------------------------------------------------------------------------
# 2. Supabase Configuration (Region: Southeast Asia - Singapore)
# ------------------------------------------------------------------------------
SUPABASE_URL=https://nsgpjfjziuedhnjkpucp.supabase.co
SUPABASE_PUBLISHABLE_KEY=<local-value>
# SUPABASE_SECRET_KEY is backend-only. Never expose to frontend or commit to version control.
SUPABASE_SECRET_KEY=<local-secret-value>
SUPABASE_JWKS_URL=https://nsgpjfjziuedhnjkpucp.supabase.co/auth/v1/.well-known/jwks.json

# ------------------------------------------------------------------------------
# 3. Database (Supabase PostgreSQL)
# ------------------------------------------------------------------------------
# DATABASE_URL: Supabase connection pooler URL for runtime application (port 6543 or 5432).
# Format (Supavisor Transaction Pooler, port 6543):
#   postgresql+asyncpg://postgres.nsgpjfjziuedhnjkpucp:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres
# Format (Supavisor Session Pooler, port 5432):
#   postgresql+asyncpg://postgres.nsgpjfjziuedhnjkpucp:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres
DATABASE_URL=postgresql+asyncpg://postgres.nsgpjfjziuedhnjkpucp:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres

# DIRECT_URL: Supabase direct connection string reserved exclusively for Alembic migrations (port 5432).
# Format (Direct Connection via IPv6/IPv4):
#   postgresql+asyncpg://postgres:[YOUR-PASSWORD]@db.nsgpjfjziuedhnjkpucp.supabase.co:5432/postgres
# Or if on IPv4 network, use Session Pooler on port 5432:
#   postgresql+asyncpg://postgres.nsgpjfjziuedhnjkpucp:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres
DIRECT_URL=postgresql+asyncpg://postgres:[YOUR-PASSWORD]@db.nsgpjfjziuedhnjkpucp.supabase.co:5432/postgres

# ------------------------------------------------------------------------------
# 4. Cache & Queue (Redis 7.2+)
# ------------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ------------------------------------------------------------------------------
# 5. JWT & Authentication
# ------------------------------------------------------------------------------
# Secret key used for HMAC-SHA256 JWT access token signing (min 32 random characters in production)
JWT_SECRET_KEY=change-this-in-production-use-a-strong-random-jwt-secret-key-32-chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Bootstrap Admin Configuration (Used by python -m app.cli.bootstrap_admin)
BOOTSTRAP_ADMIN_NAME=Admin User
BOOTSTRAP_ADMIN_EMAIL=admin@socialos.local
BOOTSTRAP_ADMIN_PASSWORD=change-me-secure-admin-password

# Social Token Encryption at Rest (AES-256-GCM, 256-bit / 32-byte key in hex or base64)
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SOCIAL_TOKEN_ENCRYPTION_KEY=change-this-in-production-use-a-strong-random-32-byte-key

# ------------------------------------------------------------------------------
# 6. Production Media Storage: AWS S3 + Amazon CloudFront
# ------------------------------------------------------------------------------
# Note: AWS S3 + CloudFront is the singular production architecture standard.
# Supabase Storage is NOT used.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=socialos-media-production
CLOUDFRONT_DOMAIN=

# ------------------------------------------------------------------------------
# 7. Local Development Media Storage: MinIO Only
# ------------------------------------------------------------------------------
# Used ONLY in local development (Docker Compose) for offline S3 API parity.
USE_LOCAL_STORAGE=true
MINIO_ENDPOINT=http://localhost:9000
MINIO_PUBLIC_ENDPOINT=http://localhost:9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET_NAME=socialos-media-local

# ------------------------------------------------------------------------------
# 8. Social OAuth Providers Configuration
# ------------------------------------------------------------------------------
# 8.1 Instagram (Meta Graph API / Instagram Basic Display)
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
INSTAGRAM_REDIRECT_URI=http://localhost:8000/api/v1/social/oauth/instagram/callback

# 8.2 Facebook (Meta Graph API v20.0)
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_REDIRECT_URI=http://localhost:8000/api/v1/social/oauth/facebook/callback

# 8.3 LinkedIn (OAuth 2.0 / Community Management API)
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:8000/api/v1/social/oauth/linkedin/callback

# 8.4 YouTube (Google OAuth 2.0 / YouTube Data API v3)
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=http://localhost:8000/api/v1/social/oauth/youtube/callback

